rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwnerAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'g.fionne@gmail.com';
    }

    function isAdmin() {
      return isOwnerAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSchoolMember() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower().matches('^[^@]+@hmes\\.tp\\.edu\\.tw$');
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll([
        'spreadsheetId',
        'tabName',
        'siteTitle',
        'siteSubtitle',
        'heroHeading',
        'heroDescription',
        'autoDynamicTitle',
        'autoTitleFromSheet',
        'updatedAt',
        'updatedByUid'
      ]) &&
      data.keys().hasOnly([
        'spreadsheetId',
        'tabName',
        'siteTitle',
        'siteSubtitle',
        'heroHeading',
        'heroDescription',
        'autoDynamicTitle',
        'autoTitleFromSheet',
        'updatedAt',
        'updatedByUid',
        'hiddenOfficialAssetIds',
        'lockedCategories',
        'lockedNavOptions'
      ]) &&
      data.spreadsheetId is string && data.spreadsheetId.size() <= 200 &&
      data.tabName is string && data.tabName.size() >= 1 && data.tabName.size() <= 100 &&
      data.siteTitle is string && data.siteTitle.size() >= 1 && data.siteTitle.size() <= 120 &&
      data.siteSubtitle is string && data.siteSubtitle.size() <= 200 &&
      data.heroHeading is string && data.heroHeading.size() <= 200 &&
      data.heroDescription is string && data.heroDescription.size() <= 1000 &&
      data.autoDynamicTitle is bool &&
      data.autoTitleFromSheet is bool &&
      data.updatedAt is timestamp &&
      data.updatedByUid is string && isValidId(data.updatedByUid) &&
      data.updatedByUid == request.auth.uid &&
      (!('hiddenOfficialAssetIds' in data) || (
        data.hiddenOfficialAssetIds is list &&
        data.hiddenOfficialAssetIds.size() <= 50 &&
        (data.hiddenOfficialAssetIds.size() == 0 || (
          data.hiddenOfficialAssetIds[0] is string &&
          data.hiddenOfficialAssetIds[0].size() >= 1 &&
          data.hiddenOfficialAssetIds[0].size() <= 64
        ))
      )) &&
      (!('lockedCategories' in data) || (
        data.lockedCategories is list &&
        data.lockedCategories.size() <= 20 &&
        (data.lockedCategories.size() == 0 || (
          data.lockedCategories[0] is string &&
          data.lockedCategories[0].size() >= 1 &&
          data.lockedCategories[0].size() <= 60
        ))
      )) &&
      (!('lockedNavOptions' in data) || (
        data.lockedNavOptions is list &&
        data.lockedNavOptions.size() <= 10 &&
        (data.lockedNavOptions.size() == 0 || (
          data.lockedNavOptions[0] is string &&
          data.lockedNavOptions[0].size() >= 1 &&
          data.lockedNavOptions[0].size() <= 40
        ))
      ));
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'addedAt', 'addedByUid']) &&
      data.keys().hasOnly(['email', 'addedAt', 'addedByUid']) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
      data.addedAt is timestamp &&
      data.addedByUid is string && isValidId(data.addedByUid) &&
      data.addedByUid == request.auth.uid;
    }

    function isValidXimenGalleryItem(data) {
      return data.keys().hasAll([
        'name',
        'fileName',
        'folderName',
        'imageUrl',
        'downloadUrl',
        'driveFileId',
        'mimeType',
        'sizeBytes',
        'uploadedByName',
        'uploadedByUid',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'name',
        'fileName',
        'folderName',
        'imageUrl',
        'downloadUrl',
        'driveFileId',
        'mimeType',
        'sizeBytes',
        'uploadedByName',
        'uploadedByUid',
        'createdAt'
      ]) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
      data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200 &&
      data.folderName is string && data.folderName.size() <= 120 &&
      data.imageUrl is string && data.imageUrl.size() >= 10 && data.imageUrl.size() <= 900000 &&
      data.downloadUrl is string && data.downloadUrl.size() >= 10 && data.downloadUrl.size() <= 900000 &&
      data.driveFileId is string && data.driveFileId.size() >= 1 && data.driveFileId.size() <= 200 &&
      data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 100 &&
      data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 52428800 &&
      data.uploadedByName is string && data.uploadedByName.size() >= 1 && data.uploadedByName.size() <= 100 &&
      data.uploadedByUid is string && isValidId(data.uploadedByUid) &&
      data.uploadedByUid == request.auth.uid &&
      data.createdAt is timestamp;
    }

    function isValidMeetingSession(data) {
      return data.keys().hasAll([
        'title',
        'meetingDate',
        'academicYear',
        'location',
        'agendaSummary',
        'meetUrl',
        'linkedPostSlug',
        'isOpen',
        'createdByName',
        'createdByUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title',
        'meetingDate',
        'academicYear',
        'location',
        'agendaSummary',
        'meetUrl',
        'linkedPostSlug',
        'audience',
        'isOpen',
        'allowLeaveReport',
        'checkinStartAt',
        'checkinEndAt',
        'createdByName',
        'createdByUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
      data.meetingDate is string && data.meetingDate.size() >= 4 && data.meetingDate.size() <= 40 &&
      data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 40 &&
      data.location is string && data.location.size() <= 160 &&
      data.agendaSummary is string && data.agendaSummary.size() <= 1000 &&
      data.meetUrl is string && data.meetUrl.size() <= 500 &&
      (data.meetUrl == '' || data.meetUrl.matches('^https://.*')) &&
      data.linkedPostSlug is string && data.linkedPostSlug.size() <= 160 &&
      (!('audience' in data) || (data.audience is string && data.audience in ['teacher', 'parent'])) &&
      data.isOpen is bool &&
      (!('allowLeaveReport' in data) || data.allowLeaveReport is bool) &&
      (!('checkinStartAt' in data) || data.checkinStartAt == null || data.checkinStartAt is timestamp) &&
      (!('checkinEndAt' in data) || data.checkinEndAt == null || data.checkinEndAt is timestamp) &&
      (
        !('checkinStartAt' in data) || data.checkinStartAt == null ||
        !('checkinEndAt' in data) || data.checkinEndAt == null ||
        data.checkinEndAt > data.checkinStartAt
      ) &&
      data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 100 &&
      data.createdByUid is string && isValidId(data.createdByUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isMeetingWithinWindow(meetingData) {
      return meetingData.isOpen == true &&
        (!('checkinStartAt' in meetingData) || meetingData.checkinStartAt == null || request.time >= meetingData.checkinStartAt) &&
        (!('checkinEndAt' in meetingData) || meetingData.checkinEndAt == null || request.time <= meetingData.checkinEndAt);
    }

    function isAttendancePresent(data) {
      return !('attendanceStatus' in data) || data.attendanceStatus == '出席';
    }

    function isValidMeetingCheckin(data) {
      return data.keys().hasAll([
        'meetingId',
        'meetingTitle',
        'userUid',
        'userName',
        'userEmail',
        'roleOrNote',
        'signatureDataUrl',
        'checkedInAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'meetingId',
        'meetingTitle',
        'userUid',
        'userName',
        'userEmail',
        'attendanceStatus',
        'leaveNote',
        'roleOrNote',
        'signatureDataUrl',
        'checkedInAt',
        'updatedAt'
      ]) &&
      data.meetingId is string && isValidId(data.meetingId) && data.meetingId.size() <= 90 &&
      data.meetingTitle is string && data.meetingTitle.size() >= 1 && data.meetingTitle.size() <= 160 &&
      data.userUid is string && isValidId(data.userUid) &&
      data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
      data.userEmail is string && data.userEmail.size() <= 200 &&
      (!isAttendancePresent(data) || data.userEmail.size() >= 5) &&
      (!('attendanceStatus' in data) || (data.attendanceStatus is string && data.attendanceStatus in ['出席', '公假', '事假', '病假', '其他請假'])) &&
      (!('leaveNote' in data) || (data.leaveNote is string && data.leaveNote.size() <= 200)) &&
      data.roleOrNote is string && data.roleOrNote.size() <= 120 &&
      data.signatureDataUrl is string &&
      data.signatureDataUrl.size() <= 200000 &&
      (
        (
          isAttendancePresent(data) &&
          data.signatureDataUrl.size() >= 22 &&
          data.signatureDataUrl.matches('^data:image/(png|webp|jpeg);base64,[A-Za-z0-9+/=]+$')
        ) || (
          !isAttendancePresent(data) &&
          (
            data.signatureDataUrl == '' ||
            (
              data.signatureDataUrl.size() >= 22 &&
              data.signatureDataUrl.matches('^data:image/(png|webp|jpeg);base64,[A-Za-z0-9+/=]+$')
            )
          )
        )
      ) &&
      data.checkedInAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidParentCheckin(data) {
      return data.keys().hasAll([
        'meetingId',
        'meetingTitle',
        'studentClassAndSeat',
        'parentName',
        'relationshipOrNote',
        'signatureDataUrl',
        'checkedInAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'meetingId',
        'meetingTitle',
        'studentClassAndSeat',
        'parentName',
        'relationshipOrNote',
        'signatureDataUrl',
        'checkedInAt',
        'updatedAt'
      ]) &&
      data.meetingId is string && isValidId(data.meetingId) && data.meetingId.size() <= 90 &&
      data.meetingTitle is string && data.meetingTitle.size() >= 1 && data.meetingTitle.size() <= 160 &&
      data.studentClassAndSeat is string && data.studentClassAndSeat.size() >= 1 && data.studentClassAndSeat.size() <= 80 &&
      data.parentName is string && data.parentName.size() >= 1 && data.parentName.size() <= 80 &&
      data.relationshipOrNote is string && data.relationshipOrNote.size() <= 120 &&
      data.signatureDataUrl is string &&
      data.signatureDataUrl.size() >= 22 &&
      data.signatureDataUrl.size() <= 200000 &&
      data.signatureDataUrl.matches('^data:image/(png|webp|jpeg);base64,[A-Za-z0-9+/=]+$') &&
      data.checkedInAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /siteConfig/{configId} {
      allow get: if isValidId(configId) && configId == 'main';
      allow list: if false;

      allow create: if isAdmin() &&
        isValidId(configId) &&
        configId == 'main' &&
        isValidSiteConfig(incoming());

      allow update: if isAdmin() &&
        isValidId(configId) &&
        configId == 'main' &&
        isValidSiteConfig(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'spreadsheetId',
          'tabName',
          'siteTitle',
          'siteSubtitle',
          'heroHeading',
          'heroDescription',
          'autoDynamicTitle',
          'autoTitleFromSheet',
          'updatedAt',
          'updatedByUid',
          'hiddenOfficialAssetIds',
          'lockedCategories',
          'lockedNavOptions'
        ]);

      allow delete: if false;
    }

    match /admins/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isOwnerAdmin());
      allow list: if false;

      allow create: if isOwnerAdmin() &&
        isValidId(userId) &&
        isValidAdminUser(incoming());

      allow update: if isOwnerAdmin() &&
        isValidId(userId) &&
        isValidAdminUser(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'addedAt', 'addedByUid']);

      allow delete: if isOwnerAdmin() && isValidId(userId);
    }

    match /ximenGalleryItems/{itemId} {
      allow get: if isValidId(itemId) && (isAdmin() || isSchoolMember());
      allow list: if isAdmin() || isSchoolMember();

      allow create: if isAdmin() &&
        isValidId(itemId) &&
        isValidXimenGalleryItem(incoming());

      allow update: if false;

      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /meetings/{meetingId} {
      // Teacher community meetings: public read allowed so all teachers (logged in or not) can receive live meeting notices and QR codes
      allow get: if isValidId(meetingId);
      allow list: if true;

      allow create: if isAdmin() &&
        isValidId(meetingId) &&
        isValidMeetingSession(incoming()) &&
        (!('audience' in incoming()) || incoming().audience == 'teacher') &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(meetingId) &&
        isValidMeetingSession(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'meetingDate',
          'academicYear',
          'location',
          'agendaSummary',
          'meetUrl',
          'linkedPostSlug',
          'audience',
          'isOpen',
          'allowLeaveReport',
          'checkinStartAt',
          'checkinEndAt',
          'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(meetingId);
    }

    match /parentMeetings/{meetingId} {
      // Dedicated School Day / parent event collection, completely separated from teacher community /meetings
      allow get: if isValidId(meetingId) && (
        isAdmin() ||
        ('audience' in existing() && existing().audience == 'parent')
      );
      allow list: if isAdmin() ||
        ('audience' in resource.data && resource.data.audience == 'parent');

      allow create: if isAdmin() &&
        isValidId(meetingId) &&
        isValidMeetingSession(incoming()) &&
        'audience' in incoming() &&
        incoming().audience == 'parent' &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(meetingId) &&
        isValidMeetingSession(incoming()) &&
        'audience' in incoming() &&
        incoming().audience == 'parent' &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'meetingDate',
          'academicYear',
          'location',
          'agendaSummary',
          'meetUrl',
          'linkedPostSlug',
          'audience',
          'isOpen',
          'allowLeaveReport',
          'checkinStartAt',
          'checkinEndAt',
          'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(meetingId);
    }

    match /meetingCheckins/{checkinId} {
      // Strict PII isolation: teacher may read only their own check-in for an existing meeting; admins may read/export full roster
      allow get: if isValidId(checkinId) && (
        isAdmin() ||
        (
          isSchoolMember() &&
          existing().userUid == request.auth.uid &&
          exists(/databases/$(database)/documents/meetings/$(existing().meetingId))
        )
      );
      allow list: if isAdmin() || (
        isSchoolMember() &&
        resource.data.userUid == request.auth.uid
      );

      // Deterministic ID ({meetingId}_{uid}) prevents duplicates; teachers may submit attendance (signed) or leave (unsigned when allowed); admins may also record leave for absent teachers
      allow create: if isValidId(checkinId) &&
        isValidMeetingCheckin(incoming()) &&
        checkinId == incoming().meetingId + '_' + incoming().userUid &&
        incoming().checkedInAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/meetings/$(incoming().meetingId)) &&
        (!('audience' in get(/databases/$(database)/documents/meetings/$(incoming().meetingId)).data) ||
          get(/databases/$(database)/documents/meetings/$(incoming().meetingId)).data.audience != 'parent') &&
        (
          (
            (isAdmin() || isSchoolMember()) &&
            incoming().userUid == request.auth.uid &&
            request.auth.token.email is string &&
            incoming().userEmail.lower() == request.auth.token.email.lower() &&
            isMeetingWithinWindow(get(/databases/$(database)/documents/meetings/$(incoming().meetingId)).data) &&
            (
              isAttendancePresent(incoming()) ||
              !('allowLeaveReport' in get(/databases/$(database)/documents/meetings/$(incoming().meetingId)).data) ||
              get(/databases/$(database)/documents/meetings/$(incoming().meetingId)).data.allowLeaveReport == true
            )
          ) || (
            isAdmin() &&
            !isAttendancePresent(incoming()) &&
            incoming().signatureDataUrl == ''
          )
        );

      allow update: if isValidId(checkinId) &&
        isValidMeetingCheckin(incoming()) &&
        incoming().meetingId == existing().meetingId &&
        incoming().userUid == existing().userUid &&
        incoming().userEmail == existing().userEmail &&
        incoming().checkedInAt == existing().checkedInAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'attendanceStatus',
              'leaveNote',
              'roleOrNote',
              'userName',
              'signatureDataUrl',
              'updatedAt'
            ])
          ) || (
            isSchoolMember() &&
            existing().userUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'attendanceStatus',
              'leaveNote',
              'roleOrNote',
              'userName',
              'signatureDataUrl',
              'updatedAt'
            ]) &&
            exists(/databases/$(database)/documents/meetings/$(existing().meetingId)) &&
            isMeetingWithinWindow(get(/databases/$(database)/documents/meetings/$(existing().meetingId)).data) &&
            (
              isAttendancePresent(incoming()) ||
              !('allowLeaveReport' in get(/databases/$(database)/documents/meetings/$(existing().meetingId)).data) ||
              get(/databases/$(database)/documents/meetings/$(existing().meetingId)).data.allowLeaveReport == true
            )
          )
        );

      allow delete: if isValidId(checkinId) && (
        isAdmin() || (
          isSchoolMember() &&
          existing().userUid == request.auth.uid &&
          exists(/databases/$(database)/documents/meetings/$(existing().meetingId)) &&
          isMeetingWithinWindow(get(/databases/$(database)/documents/meetings/$(existing().meetingId)).data)
        )
      );
    }

    match /parentCheckins/{checkinId} {
      // Strictly isolate parent/student check-in records to admins for roster management & PDF export (zero public or non-admin teacher read/list/scrape)
      allow get: if isValidId(checkinId) && isAdmin();
      allow list: if isAdmin();

      // Login-free School Day parent check-in: permitted ONLY for existing, open, in-window /parentMeetings (or legacy /meetings with audience == 'parent')
      allow create: if isValidId(checkinId) &&
        isValidParentCheckin(incoming()) &&
        incoming().checkedInAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            exists(/databases/$(database)/documents/parentMeetings/$(incoming().meetingId)) &&
            get(/databases/$(database)/documents/parentMeetings/$(incoming().meetingId)).data.audience == 'parent' &&
            isMeetingWithinWindow(get(/databases/$(database)/documents/parentMeetings/$(incoming().meetingId)).data)
          ) || (
            exists(/databases/$(database)/documents/meetings/$(incoming().meetingId)) &&
            get(/databases/$(database)/documents/meetings/$(incoming().meetingId)).data.audience == 'parent' &&
            isMeetingWithinWindow(get(/databases/$(database)/documents/meetings/$(incoming().meetingId)).data)
          )
        );

      allow update: if isAdmin() &&
        isValidId(checkinId) &&
        isValidParentCheckin(incoming()) &&
        incoming().meetingId == existing().meetingId &&
        incoming().checkedInAt == existing().checkedInAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'studentClassAndSeat',
          'parentName',
          'relationshipOrNote',
          'signatureDataUrl',
          'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(checkinId);
    }
  }
}
