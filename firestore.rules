rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwnerAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'g.fionne@gmail.com';
    }

    function isAdmin() {
      return isOwnerAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSchoolMember() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower().matches('^[^@]+@hmes\\.tp\\.edu\\.tw$');
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll([
        'spreadsheetId',
        'tabName',
        'siteTitle',
        'siteSubtitle',
        'heroHeading',
        'heroDescription',
        'autoDynamicTitle',
        'autoTitleFromSheet',
        'updatedAt',
        'updatedByUid'
      ]) &&
      data.keys().hasOnly([
        'spreadsheetId',
        'tabName',
        'siteTitle',
        'siteSubtitle',
        'heroHeading',
        'heroDescription',
        'autoDynamicTitle',
        'autoTitleFromSheet',
        'updatedAt',
        'updatedByUid',
        'hiddenOfficialAssetIds',
        'lockedCategories',
        'lockedNavOptions'
      ]) &&
      data.spreadsheetId is string && data.spreadsheetId.size() <= 200 &&
      data.tabName is string && data.tabName.size() >= 1 && data.tabName.size() <= 100 &&
      data.siteTitle is string && data.siteTitle.size() >= 1 && data.siteTitle.size() <= 120 &&
      data.siteSubtitle is string && data.siteSubtitle.size() <= 200 &&
      data.heroHeading is string && data.heroHeading.size() <= 200 &&
      data.heroDescription is string && data.heroDescription.size() <= 1000 &&
      data.autoDynamicTitle is bool &&
      data.autoTitleFromSheet is bool &&
      data.updatedAt is timestamp &&
      data.updatedByUid is string && isValidId(data.updatedByUid) &&
      data.updatedByUid == request.auth.uid &&
      (!('hiddenOfficialAssetIds' in data) || (
        data.hiddenOfficialAssetIds is list &&
        data.hiddenOfficialAssetIds.size() <= 50 &&
        (data.hiddenOfficialAssetIds.size() == 0 || (
          data.hiddenOfficialAssetIds[0] is string &&
          data.hiddenOfficialAssetIds[0].size() >= 1 &&
          data.hiddenOfficialAssetIds[0].size() <= 64
        ))
      )) &&
      (!('lockedCategories' in data) || (
        data.lockedCategories is list &&
        data.lockedCategories.size() <= 20 &&
        (data.lockedCategories.size() == 0 || (
          data.lockedCategories[0] is string &&
          data.lockedCategories[0].size() >= 1 &&
          data.lockedCategories[0].size() <= 60
        ))
      )) &&
      (!('lockedNavOptions' in data) || (
        data.lockedNavOptions is list &&
        data.lockedNavOptions.size() <= 10 &&
        (data.lockedNavOptions.size() == 0 || (
          data.lockedNavOptions[0] is string &&
          data.lockedNavOptions[0].size() >= 1 &&
          data.lockedNavOptions[0].size() <= 40
        ))
      ));
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'addedAt', 'addedByUid']) &&
      data.keys().hasOnly(['email', 'addedAt', 'addedByUid']) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
      data.addedAt is timestamp &&
      data.addedByUid is string && isValidId(data.addedByUid) &&
      data.addedByUid == request.auth.uid;
    }

    function isValidXimenGalleryItem(data) {
      return data.keys().hasAll([
        'name',
        'fileName',
        'folderName',
        'imageUrl',
        'downloadUrl',
        'driveFileId',
        'mimeType',
        'sizeBytes',
        'uploadedByName',
        'uploadedByUid',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'name',
        'fileName',
        'folderName',
        'imageUrl',
        'downloadUrl',
        'driveFileId',
        'mimeType',
        'sizeBytes',
        'uploadedByName',
        'uploadedByUid',
        'createdAt'
      ]) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
      data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200 &&
      data.folderName is string && data.folderName.size() <= 120 &&
      data.imageUrl is string && data.imageUrl.size() >= 10 && data.imageUrl.size() <= 900000 &&
      data.downloadUrl is string && data.downloadUrl.size() >= 10 && data.downloadUrl.size() <= 900000 &&
      data.driveFileId is string && data.driveFileId.size() >= 1 && data.driveFileId.size() <= 200 &&
      data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 100 &&
      data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 52428800 &&
      data.uploadedByName is string && data.uploadedByName.size() >= 1 && data.uploadedByName.size() <= 100 &&
      data.uploadedByUid is string && isValidId(data.uploadedByUid) &&
      data.uploadedByUid == request.auth.uid &&
      data.createdAt is timestamp;
    }

    function isValidMeetingSession(data) {
      return data.keys().hasAll([
        'title',
        'meetingDate',
        'academicYear',
        'location',
        'agendaSummary',
        'meetUrl',
        'linkedPostSlug',
        'isOpen',
        'createdByName',
        'createdByUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title',
        'meetingDate',
        'academicYear',
        'location',
        'agendaSummary',
        'meetUrl',
        'linkedPostSlug',
        'isOpen',
        'createdByName',
        'createdByUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
      data.meetingDate is string && data.meetingDate.size() >= 4 && data.meetingDate.size() <= 40 &&
      data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 40 &&
      data.location is string && data.location.size() <= 160 &&
      data.agendaSummary is string && data.agendaSummary.size() <= 1000 &&
      data.meetUrl is string && data.meetUrl.size() <= 500 &&
      (data.meetUrl == '' || data.meetUrl.matches('^https://.*')) &&
      data.linkedPostSlug is string && data.linkedPostSlug.size() <= 160 &&
      data.isOpen is bool &&
      data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 100 &&
      data.createdByUid is string && isValidId(data.createdByUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidMeetingCheckin(data) {
      return data.keys().hasAll([
        'meetingId',
        'meetingTitle',
        'userUid',
        'userName',
        'userEmail',
        'roleOrNote',
        'checkedInAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'meetingId',
        'meetingTitle',
        'userUid',
        'userName',
        'userEmail',
        'roleOrNote',
        'checkedInAt',
        'updatedAt'
      ]) &&
      data.meetingId is string && isValidId(data.meetingId) && data.meetingId.size() <= 90 &&
      data.meetingTitle is string && data.meetingTitle.size() >= 1 && data.meetingTitle.size() <= 160 &&
      data.userUid is string && isValidId(data.userUid) &&
      data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
      data.userEmail is string && data.userEmail.size() >= 5 && data.userEmail.size() <= 200 &&
      data.roleOrNote is string && data.roleOrNote.size() <= 120 &&
      data.checkedInAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /siteConfig/{configId} {
      // Publicly readable so visitors on GitHub Pages and AI Studio load the exact same config in real time
      allow get: if isValidId(configId) && configId == 'main';
      allow list: if false;

      allow create: if isAdmin() &&
        isValidId(configId) &&
        configId == 'main' &&
        isValidSiteConfig(incoming());

      allow update: if isAdmin() &&
        isValidId(configId) &&
        configId == 'main' &&
        isValidSiteConfig(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'spreadsheetId',
          'tabName',
          'siteTitle',
          'siteSubtitle',
          'heroHeading',
          'heroDescription',
          'autoDynamicTitle',
          'autoTitleFromSheet',
          'updatedAt',
          'updatedByUid',
          'hiddenOfficialAssetIds',
          'lockedCategories',
          'lockedNavOptions'
        ]);

      allow delete: if false;
    }

    match /admins/{userId} {
      // Only the admin themselves or the owner admin can read an individual admin doc (no PII list scraping)
      allow get: if isVerifiedUser() && isValidId(userId) && (request.auth.uid == userId || isOwnerAdmin());
      allow list: if false;

      allow create: if isOwnerAdmin() &&
        isValidId(userId) &&
        isValidAdminUser(incoming());

      allow update: if isOwnerAdmin() &&
        isValidId(userId) &&
        isValidAdminUser(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'addedAt', 'addedByUid']);

      allow delete: if isOwnerAdmin() && isValidId(userId);
    }

    match /ximenGalleryItems/{itemId} {
      // Teachers/admins and verified @hmes.tp.edu.tw school accounts may view and download gallery items
      allow get: if isValidId(itemId) && (isAdmin() || isSchoolMember());
      allow list: if isAdmin() || isSchoolMember();

      // Only authenticated teachers/admins may upload or delete gallery items
      allow create: if isAdmin() &&
        isValidId(itemId) &&
        isValidXimenGalleryItem(incoming());

      allow update: if false;

      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /meetings/{meetingId} {
      // Private community teacher meetings: strictly gated to @hmes.tp.edu.tw school members and admins
      allow get: if isValidId(meetingId) && (isAdmin() || isSchoolMember());
      allow list: if isAdmin() || isSchoolMember();

      allow create: if isAdmin() &&
        isValidId(meetingId) &&
        isValidMeetingSession(incoming()) &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(meetingId) &&
        isValidMeetingSession(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'meetingDate',
          'academicYear',
          'location',
          'agendaSummary',
          'meetUrl',
          'linkedPostSlug',
          'isOpen',
          'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(meetingId);
    }

    match /meetingCheckins/{checkinId} {
      // Strict PII isolation: teacher may read only their own check-in; admins may read/export full roster
      allow get: if isValidId(checkinId) && (
        isAdmin() ||
        (isSchoolMember() && existing().userUid == request.auth.uid)
      );
      allow list: if isAdmin() || (
        isSchoolMember() &&
        resource.data.userUid == request.auth.uid
      );

      // Deterministic ID ({meetingId}_{uid}) prevents duplicates; Master Gate ensures meeting exists and is open
      allow create: if isValidId(checkinId) &&
        isValidMeetingCheckin(incoming()) &&
        (isAdmin() || isSchoolMember()) &&
        checkinId == incoming().meetingId + '_' + request.auth.uid &&
        incoming().userUid == request.auth.uid &&
        request.auth.token.email is string &&
        incoming().userEmail.lower() == request.auth.token.email.lower() &&
        incoming().checkedInAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/meetings/$(incoming().meetingId)) &&
        get(/databases/$(database)/documents/meetings/$(incoming().meetingId)).data.isOpen == true;

      allow update: if isValidId(checkinId) &&
        isValidMeetingCheckin(incoming()) &&
        incoming().meetingId == existing().meetingId &&
        incoming().userUid == existing().userUid &&
        incoming().userEmail == existing().userEmail &&
        incoming().checkedInAt == existing().checkedInAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() || (
            isSchoolMember() &&
            existing().userUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['roleOrNote', 'userName', 'updatedAt']) &&
            exists(/databases/$(database)/documents/meetings/$(existing().meetingId)) &&
            get(/databases/$(database)/documents/meetings/$(existing().meetingId)).data.isOpen == true
          )
        );

      allow delete: if isValidId(checkinId) && (
        isAdmin() || (
          isSchoolMember() &&
          existing().userUid == request.auth.uid &&
          exists(/databases/$(database)/documents/meetings/$(existing().meetingId)) &&
          get(/databases/$(database)/documents/meetings/$(existing().meetingId)).data.isOpen == true
        )
      );
    }
  }
}
